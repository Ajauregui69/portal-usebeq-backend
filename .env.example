# Database Configuration (SQL Server / Azure SQL Database)
DATABASE_URL=mssql+pymssql://usebeq_user:usebeq_password_123@localhost:1433/usebeq_portal

# Azure SQL Database:
# DATABASE_URL=mssql+pymssql://usebeq_admin:TuPassword@usebeq-sql-server.database.windows.net:1433/portal_usebeq

# Para MySQL (legacy, ya no se usa en produccion, se deja como referencia):
# DATABASE_URL=mysql+pymysql://usebeq_user:usebeq_password_123@localhost/usebeq_portal?charset=utf8mb4

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Email Configuration
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-password
MAIL_FROM=noreply@usebeq.edu.mx
MAIL_PORT=587
MAIL_SERVER=smtp.example.com
MAIL_FROM_NAME=Portal USEBEQ

# Application
PROJECT_NAME=Portal USEBEQ API
VERSION=1.0.0
API_V1_STR=/api/v1

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# SendGrid (transactional email)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx
